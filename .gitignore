# Sensitive raw personal data (protect raw Spotify user JSON from public repos)
data/raw/*
!data/raw/.gitkeep

# Interim & Heavy parquet data
data/interim/*
!data/interim/.gitkeep
data/processed/*.parquet
!data/processed/.gitkeep
data/ml/*.parquet
!data/ml/.gitkeep

# Sample data is safe and tracked for public demonstration
!data/sample/sample_streaming_history.json
!data/sample/.gitkeep

# Environment variables & secrets
.env
.env.local
